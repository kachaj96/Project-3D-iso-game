* text=auto eol=lf

# Source art goes to Git LFS. Exported PNGs in assets/ stay in normal git.
art_source/** filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Binary files that must not get line-ending conversion
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
