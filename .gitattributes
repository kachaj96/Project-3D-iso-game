* text=auto eol=lf

# Source art and the cleaned map pictures go to Git LFS (the .import files next to them stay normal text).
art_source/** filter=lfs diff=lfs merge=lfs -text
assets/art/**/*.png filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text

# Binary files that must not get line-ending conversion
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.ttf binary
*.otf binary
